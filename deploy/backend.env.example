# Copy to /etc/pqc-chat.env (permissions 0600). Do not commit secrets.
DJANGO_ENV=development
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=replace-with-a-unique-50-plus-character-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL is required whenever DJANGO_ENV=production.
DB_BACKEND=postgres
POSTGRES_DB=antiq
POSTGRES_USER=antiq
POSTGRES_PASSWORD=replace-with-a-database-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Kept empty by default. Optional modules, including tenant RBAC, must be
# enabled explicitly: ANTIQ_BACKEND_PLUGINS=rbac
ANTIQ_BACKEND_PLUGINS=
# Comma-separated Google/account email addresses that can initialize tenant
# roles before another workspace admin exists. Leave empty when RBAC is off.
RBAC_BOOTSTRAP_ADMIN_EMAILS=

DJANGO_MEDIA_ROOT=/var/lib/antiq/media
# Chat attachments always use resumable encrypted sessions. Keep this product
# limit separate from the small reverse-proxy per-request limit.
ATTACHMENTS_MAX_FILE_BYTES=2147483648
AVATAR_MAX_BYTES=2097152
CRYPTO_RECOVERY_REQUIRE_DEVICE_APPROVAL=true
CRYPTO_RECOVERY_REQUIRE_REGISTERED_DEVICE=true
CRYPTO_RECOVERY_GRANT_TTL_SECONDS=300
CRYPTO_PROTOCOL_MODE=v2
