[Unit]
Description=antiQ Django ASGI Backend
After=network.target

[Service]
Type=simple
User=__ANTIQ_USER__
WorkingDirectory=__ANTIQ_ROOT__/backend
EnvironmentFile=__ANTIQ_ENV_FILE__
Environment=PYTHONUNBUFFERED=1
ExecStart=__ANTIQ_ROOT__/.venv/bin/daphne -b 127.0.0.1 -p 8020 config.asgi:application
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
