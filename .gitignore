# Release bundles and generated application packages belong in CI artifacts
# or GitHub Releases, never in source control or Git history.
/releases/
*.apk
*.aab
*.ipa
*.app/
*.dmg

# The SDK is vendored as source under packages/pqc_engine_sdk/ for local,
# reproducible builds. Its own Git metadata is excluded from this repository.
/packages/pqc_engine_sdk/.git/

# Runtime attachment data belongs to the configured media volume/server.
/shared/media/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
